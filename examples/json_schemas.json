      "success": true,
      "meta": { "user_id": 1, "count": 3, "page": 1, "page_size": 3 },
      "data": [
        {
          "transaction_id": 1,
          "category_code": "INCOMING_MONEY",
          "amount": 2000.00,
          "fee": 0.00,
          "transaction_date": "2024-05-10T16:30:51Z",
