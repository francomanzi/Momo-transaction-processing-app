    "api_response_get_transaction_by_id": {
      "_comment": "Example response for GET /api/v1/transactions/5",
      "success": true,
      "data": {
        "transaction_id": 5,
        "financial_tx_id": null,
        "amount": 20000.00,
        "fee": 0.00,
        "transaction_date": "2024-11-23T13:23:44Z",
        "status": "COMPLETED",
        "category": { "category_code": "AGENT_WITHDRAWAL", "category_name": "Agent Cash Withdrawal" },
        "participants": [
          { "participant_role": "SENDER", "user": { "user_id": 1, "full_name": "Abebe Chala Chebudie", "phone_number": "250795963036" } },
          { "participant_role": "AGENT",  "user": { "user_id": 7, "full_name": "Agent Sophia", "phone_number": "250790777779" } }
        ]
      }
    },

    "api_response_list_transactions_by_user": {
